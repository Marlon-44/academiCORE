# ============================================================
# academiCORE — variables de entorno (copiar a .env y rellenar)
# docker compose lee .env automáticamente.
# ============================================================

# ---- Base de datos ----
# Opción A — Supabase (recomendada):
#   Supabase Dashboard → Project Settings → Database → Connection string.
#   Usar el "Session pooler" (puerto 5432, IPv4) — el host directo
#   db.<ref>.supabase.co es solo IPv6 y suele fallar desde Docker local.
#   El usuario del pooler lleva sufijo: postgres.<ref-del-proyecto>
DB_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.pxfitbmwillrxxbjlhjv
DB_PASSWORD=PEGA_AQUI_EL_PASSWORD_DE_TU_BASE

# Opción B — Postgres local del compose (perfil localdb):
#   docker compose --profile localdb up -d
#   DB_URL=jdbc:postgresql://postgres:5432/academicore
#   DB_USER=academicore
#   DB_PASSWORD=academicore_dev

# ---- Supabase API (Storage: buckets campus/aspirantes) ----
SUPABASE_URL=https://pxfitbmwillrxxbjlhjv.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.TU_SERVICE_KEY_AQUI
