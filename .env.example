# ============================================================
# academiCORE - .env.example  (plantilla - rellenar y renombrar a .env)
# NUNCA poner valores reales en este archivo: va a git.
# ============================================================

# ---- Base de datos (Supabase pooler, sesión) ----
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_PASSWORD=<password-de-la-bd>

# Postgres local alterno (solo con --profile localdb, son los defaults):
# DB_URL=jdbc:postgresql://postgres:5432/academicore
# DB_USER=academicore
# DB_PASSWORD=academicore_dev

# ---- Supabase API (Storage: buckets campus/aspirantes) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<service-role-key>

# ---- CORS / cookie de sesión (deploy dividido Vercel->Render) ----
# CORS_ALLOWED_ORIGINS=https://<app>.vercel.app
# COOKIE_SAMESITE=None
# COOKIE_SECURE=true

# ---- Credenciales demo del aplicativo (referencia - el login las valida contra la BD) ----
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin123
# Estudiantes: usuario = codigo estudiantil (0222500001..0222500006), clave = numero de documento
# Docentes:    usuario = numero de documento, clave = numero de documento
